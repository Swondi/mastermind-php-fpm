# Symfony/framework-bundle
APP_ENV=dev
APP_SECRET=""

# Docker variables
POSTGRES_PASSWORD=""
POSTGRES_USER=""
POSTGRES_DB=""
POSTGRES_CONTAINER=""

# Doctrine/doctrine-bundle
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_CONTAINER}:5432/${POSTGRES_DB}?serverVersion=13"

# lexik/jwt-authentication-bundle
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=c5ad05fddcadc07105749c092a57d319a8eb5b39f4b5a5258f72c20858acfd52

# nelmio/cors-bundle
CORS_ALLOW_ORIGIN=^.*$

# symfony/messenger
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0